{
  "expo": {
    "name": "kbdl-employee",
    "slug": "kbdl-employee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "kbdlemployee",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.kbdlemployee"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.kbdlemployee",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "plugins": [
      "expo-localization",
      "expo-dev-client",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "owner": "aryanraj923s-organization",
    "extra": {
      "eas": {
        "projectId": "6b018aa3-8c64-4978-8acd-a78197c44160"
      }
    }
  }
}