# Copy to .env.local for your machine (gitignored):
#   copy .env.example .env.local
#
# Used by src/lib/api-client.ts → NEXT_PUBLIC_API_URL
# Must include /api/v1 suffix.
# Restart `next dev` after changing NEXT_PUBLIC_* vars.

# Local backend (pnpm / Docker on this PC)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Azure VM Docker backend (uncomment and comment localhost above):
# NEXT_PUBLIC_API_URL=http://20.197.60.119:8000/api/v1
