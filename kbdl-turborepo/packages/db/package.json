{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "main": "./src/server/index.ts",
  "types": "./src/server/index.ts",
  "exports": {
    ".": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./shared": {
      "types": "./src/shared/index.ts",
      "default": "./src/shared/index.ts"
    }
  },
  "scripts": {
    "generate": "node --env-file=../../.env ./scripts/prisma-cli.mjs generate",
    "push": "node --env-file=../../.env ./scripts/prisma-cli.mjs db push",
    "migrate:deploy": "node --env-file=../../.env ./scripts/prisma-cli.mjs migrate deploy",
    "build": "node --env-file=../../.env ./scripts/prisma-cli.mjs generate",
    "clone-db": "node --env-file=../../.env ./scripts/clone-database.mjs",
    "seed": "node --env-file=../../.env ./prisma/seed.mjs",
    "db:reset-seed": "node --env-file=../../.env ./scripts/prisma-cli.mjs db push --force-reset --accept-data-loss && node --env-file=../../.env ./prisma/seed.mjs"
  },
  "prisma": {
    "seed": "node --env-file=../../.env ./prisma/seed.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@repo/validator": "workspace:^",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0"
  }
}