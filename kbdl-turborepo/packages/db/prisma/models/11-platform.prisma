// =============================================================================
// PLATFORM — admin, OTP, leads, push/notifications
// =============================================================================

model Admin {
  id            String @id @default(uuid()) @db.Uuid
  name          String @db.VarChar
  email         String @unique @db.VarChar
  phone_no      String @unique @db.VarChar
  role          String @default("admin")
  password_hash String @db.VarChar

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  hr_invites HrInvite[]

  @@map("admins")
}

/// Company owner (or product admin) invite: HR joins that company as employee with role HR.
model HrInvite {
  id String @id @default(uuid()) @db.Uuid

  email     String @db.VarChar
  phone_no  String @db.VarChar
  full_name String @db.VarChar

  status HrInviteStatus @default(pending)

  invited_by_admin_id String? @db.Uuid
  invited_by_user_id  String? @db.Uuid
  user_id             String? @db.Uuid
  company_id          String? @db.Uuid

  expires_at  DateTime  @db.Timestamptz()
  accepted_at DateTime? @db.Timestamptz()

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  invited_by      Admin?   @relation(fields: [invited_by_admin_id], references: [id], onDelete: Restrict)
  invited_by_user User?    @relation("HrInviteSentBy", fields: [invited_by_user_id], references: [id], onDelete: SetNull)
  user            User?    @relation("HrInviteSubject", fields: [user_id], references: [id], onDelete: SetNull)
  company         Company? @relation(fields: [company_id], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([invited_by_admin_id])
  @@index([invited_by_user_id])
  @@map("hr_invites")
}


model OtpVerification {
  id String @id @default(uuid()) @db.Uuid

  phone_no String? @db.VarChar
  email    String? @db.VarChar

  otp  String @db.VarChar
  role String @db.VarChar

  payload Json? @default("{}")

  expires_at DateTime @db.Timestamptz()
  created_at DateTime @default(now()) @db.Timestamptz()

  @@unique([phone_no, role])
  @@unique([email, role])
  @@map("otp_verifications")
}

model Lead {
  id String @id @default(uuid()) @db.Uuid

  fullName     String
  email        String @db.VarChar(255)
  mobileNumber String @db.VarChar(20)

  subject String @db.VarChar(255)
  message String @db.Text

  isResolved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@map("leads")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  user_id   String   @db.Uuid
  token     String   @unique
  platform  String?
  deviceId  String?  @map("device_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

model Notification {
  id      String @id @default(uuid()) @db.Uuid
  user_id String @db.Uuid
  type    String
  title   String
  body    String
  data    Json?

  isRead Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, isRead])
  @@index([user_id])
  @@map("notifications")
}

model NotificationPreference {
  user_id String @id @db.Uuid

  shiftSwap Boolean @default(true) @map("shift_swap")
  jobAlert  Boolean @default(true) @map("job_alert")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("notification_preferences")
}
