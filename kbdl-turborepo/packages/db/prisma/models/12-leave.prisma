// =============================================================================
// LEAVE — company policy + per-employment requests
// =============================================================================

model CompanyLeavePolicy {
  id String @id @default(uuid()) @db.Uuid

  company_id String @unique @db.Uuid

  accrue_per_month     Decimal @default(1.00) @db.Decimal(5, 2)
  annual_quota         Decimal @default(12.00) @db.Decimal(6, 2)
  max_carry_forward    Int     @default(12)
  carry_forward_at_year_end Boolean @default(true)
  encash_excess        Boolean @default(true)
  policy_lines         Json    @default("[]")

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("company_leave_policies")
}

model CompanyLeaveType {
  id String @id @default(uuid()) @db.Uuid

  company_id String @db.Uuid

  name           String  @db.VarChar
  days_per_year  Decimal @default(12.00) @db.Decimal(6, 2)
  is_paid        Boolean @default(true)
  is_active      Boolean @default(true)
  sort_order     Int     @default(0)

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  company  Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  requests LeaveRequest[]

  @@unique([company_id, name])
  @@index([company_id])
  @@map("company_leave_types")
}

model LeaveRequest {
  id String @id @default(uuid()) @db.Uuid

  company_id    String @db.Uuid
  employment_id String @db.Uuid
  leave_type_id String @db.Uuid

  from_date DateTime @db.Date
  to_date   DateTime @db.Date
  days      Decimal  @db.Decimal(6, 2)
  reason    String   @db.VarChar

  /// hr = employer/HR applied (auto-approved). manager = reporting manager applied (needs HR approval).
  applied_by_kind LeaveAppliedByKind
  applied_by_company_member_id String? @db.Uuid
  decided_by_company_member_id String? @db.Uuid

  status     LeaveRequestStatus @default(pending)
  applied_at DateTime           @default(now()) @db.Timestamptz()
  decided_at DateTime?          @db.Timestamptz()

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  company    Company            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  employment EmployeeEmployment @relation(fields: [employment_id], references: [id], onDelete: Cascade)
  leave_type CompanyLeaveType   @relation(fields: [leave_type_id], references: [id], onDelete: Restrict)
  applied_by CompanyMember?     @relation("LeaveAppliedBy", fields: [applied_by_company_member_id], references: [id], onDelete: SetNull)
  decided_by CompanyMember?     @relation("LeaveDecidedBy", fields: [decided_by_company_member_id], references: [id], onDelete: SetNull)

  @@index([company_id])
  @@index([employment_id])
  @@index([status])
  @@map("leave_requests")
}
