// =============================================================================
// HRMS — employer-managed workforce (separate from app User until linked)
// =============================================================================
// WorkforcePerson     → phone identity HR creates; optional linked_user_id
// EmployeeEmployment  → employment stint at a company (active/past)
// EmployeeHrProfile   → onboard/profile snapshot for one employment
// EmployeeHrAddress   → present/permanent address rows
// EmployeeHrDocument  → extra docs after onboard
// =============================================================================

model WorkforcePerson {
  id String @id @default(uuid()) @db.Uuid

  phone_no    String  @unique @db.VarChar
  karigari_id String? @unique @db.VarChar

  /// Set when worker registers / logs into the employee app (phone OTP match).
  linked_user_id String? @unique @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  linked_user User?                @relation(fields: [linked_user_id], references: [id], onDelete: SetNull)
  employments EmployeeEmployment[]

  @@map("workforce_persons")
}


model EmployeeEmployment {
  id String @id @default(uuid()) @db.Uuid

  company_id          String @db.Uuid
  workforce_person_id String @db.Uuid

  employee_no        String?            @db.VarChar
  /// Filter flag — only one active row per (company_id, workforce_person_id); see partial unique index in migrations.
  is_active          Boolean            @default(true)
  /// Set when is_active=false: why the stint ended.
  separation_reason  SeparationReason?

  joined_at DateTime  @db.Timestamptz()
  left_at   DateTime? @db.Timestamptz()

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  company          Company         @relation(fields: [company_id], references: [id])
  workforce_person WorkforcePerson @relation(fields: [workforce_person_id], references: [id])
  hr_profile       EmployeeHrProfile?
  company_member   CompanyMember?

  @@index([company_id, workforce_person_id])
  @@index([company_id])
  @@index([workforce_person_id])
  @@index([is_active])
  @@map("employee_employments")
}

/// Employer HR onboard / profile fields for an employment row.
/// Document fields store https URLs (no multipart on create API).
model EmployeeHrProfile {
  id String @id @default(uuid()) @db.Uuid

  employment_id String @unique @db.Uuid

  onboarding_stage OnboardingStage @default(onboard)

  // Personal
  full_name                   String  @db.VarChar
  email                       String? @db.VarChar
  date_of_birth               DateTime? @db.Date
  gender                      String? @db.VarChar
  /// Legacy free-text; prefer employee_hr_addresses.present
  address                     String? @db.Text
  blood_group                 String? @db.VarChar
  alternate_phone             String? @db.VarChar
  marital_status              MaritalStatus?
  father_name                 String? @db.VarChar
  mother_name                 String? @db.VarChar
  nationality                 String? @default("Indian") @db.VarChar
  religion                    String? @db.VarChar
  languages_known             String? @db.VarChar
  emergency_contact_name      String? @db.VarChar
  emergency_contact_relation  String? @db.VarChar
  emergency_contact_phone     String? @db.VarChar

  // Job / work — per-stint snapshots; live manager/shift on CompanyMember + EmployeeShift
  designation_id           String?  @db.Uuid
  department_id            String?  @db.Uuid
  branch_location          String?  @db.VarChar
  employee_type            String?  @db.VarChar
  work_location            String?  @db.VarChar
  skill_trade              String?  @db.VarChar
  experience_years         Decimal? @db.Decimal(5, 2)
  certification_licenses   String?  @db.Text
  safety_training_completed Boolean?
  probation_period_months   Int?
  notice_period_days        Int?
  weekly_off                String?  @db.VarChar
  confirmation_date         DateTime? @db.Date
  working_hours             String?  @db.VarChar

  // Payment / salary
  payment_method             String?  @db.VarChar
  payment_details            Json?
  basic_salary               Decimal? @db.Decimal(12, 2)
  salary_type                String?  @db.VarChar
  salary_payment_frequency   String?  @db.VarChar
  overtime_eligible          Boolean?
  pf_applicable              Boolean?
  esi_applicable             Boolean?

  // Identity — document links only (URLs)
  aadhaar_number           String? @db.VarChar
  pan_number               String? @db.VarChar
  driving_license_number   String? @db.VarChar
  voter_id                 String? @db.VarChar
  uan_number               String? @db.VarChar
  esi_number               String? @db.VarChar
  pf_number                String? @db.VarChar
  identity_document_url    String? @db.Text
  additional_document_url  String? @db.Text

  notes String? @db.Text

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  employment  EmployeeEmployment  @relation(fields: [employment_id], references: [id], onDelete: Cascade)
  designation CompanyDesignation? @relation(fields: [designation_id], references: [id], onDelete: SetNull)
  department  Department?         @relation("HrProfileDepartment", fields: [department_id], references: [id], onDelete: SetNull)
  addresses   EmployeeHrAddress[]
  documents   EmployeeHrDocument[]

  @@index([designation_id])
  @@index([department_id])
  @@map("employee_hr_profiles")
}

/// Company-scoped address snapshot per employment HR profile (present + permanent).
model EmployeeHrAddress {
  id String @id @default(uuid()) @db.Uuid

  hr_profile_id String        @db.Uuid
  type          HrAddressType
  line1         String?       @db.VarChar
  line2         String?       @db.VarChar
  city          String?       @db.VarChar
  state         String?       @db.VarChar
  pincode       String?       @db.VarChar(10)
  country       String        @default("IN") @db.VarChar(2)

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  hr_profile EmployeeHrProfile @relation(fields: [hr_profile_id], references: [id], onDelete: Cascade)

  @@unique([hr_profile_id, type])
  @@index([hr_profile_id])
  @@map("employee_hr_addresses")
}

/// Extra HR documents uploaded after onboard (education cert, police verification, etc.)
model EmployeeHrDocument {
  id String @id @default(uuid()) @db.Uuid

  hr_profile_id   String  @db.Uuid
  document_type   String  @db.VarChar(120)
  document_number String? @db.VarChar(80)
  file_key        String  @db.Text
  file_name       String? @db.VarChar(255)
  expiry_date     DateTime? @db.Date

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  hr_profile EmployeeHrProfile @relation(fields: [hr_profile_id], references: [id], onDelete: Cascade)

  @@index([hr_profile_id])
  @@map("employee_hr_documents")
}
