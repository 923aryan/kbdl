generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PlatformType {
  EMPLOYEE
  EMPLOYER

  @@map("platform_type")
}

enum ShiftStatus {
  open
  approved
  completed
  cancelled
  absent
  rejected

  @@map("shift_status")
}

enum PayType {
  HOURLY
  FIXED

  @@map("pay_type")
}

enum ShiftApplicationStatus {
  pending
  accepted
  rejected
  withdrawn

  @@map("shift_application_status")
}

enum ShiftApplicationType {
  invited
  applied

  @@map("shift_application_type")
}

enum SalaryType {
  hourly
  daily
  weekly
  monthly

  @@map("salary_type")
}

enum JobStatus {
  draft
  open
  paused
  closed
  expired

  @@map("job_status")
}

enum EmploymentType {
  full_time
  part_time
  contract
  temporary
  internship
  freelance

  @@map("employment_type")
}

enum JobWorkType {
  onsite
  remote
  hybrid

  @@map("job_work_type")
}

enum JobApplicationStatus {
  applied
  under_review
  shortlisted
  interview_scheduled
  selected
  hired
  rejected
  withdrawn

  @@map("job_application_status")
}

enum TargetAudience {
  worker
  company
  individual
  contractor

  @@map("target_audience")
}

enum SubscriptionStatus {
  active
  expired
  cancelled
  pending

  @@map("subscription_status")
}

enum EmploymentStatus {
  pending
  active
  inactive
  terminated
  resigned

  @@map("employment_status")
}

enum TransactionType {
  payment
  refund
  payout

  @@map("transaction_type")
}

enum TransactionStatus {
  pending
  success
  failed

  @@map("transaction_status")
}

enum PaymentMode {
  cash
  upi

  @@map("payment_mode")
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded

  @@map("payment_status")
}

// ---------------------------------------------------------------------------
// Identity — single User table (auth + profile)
// ---------------------------------------------------------------------------

model User {
  id String @id @default(uuid()) @db.Uuid

  name        String? @db.VarChar
  karigari_id String? @db.VarChar

  phone_no String  @unique @db.VarChar
  email    String? @unique @db.VarChar

  password_hash String? @db.VarChar

  default_address String?  @db.VarChar
  skills          String[]
  experience      Int?
  city            String?  @db.VarChar
  area            String?  @db.VarChar
  preferences     Json?    @default("{}")

  // PostGIS geography type
  location Unsupported("geography(Point, 4326)")?

  rating_avg         Decimal? @db.Decimal(3, 2)
  rating_count       Int?
  verification_level Int?
  extra_shift        Boolean  @default(true)

  refresh_token String? @db.VarChar

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  // Relations
  companyMemberships CompanyMember[]

  original_shifts    Shift[] @relation("OriginalEmployeeShift")
  replacement_shifts Shift[] @relation("ReplacementEmployeeShift")

  jobApplications   JobApplication[]
  shiftApplications ShiftApplication[]

  employments EmployeeEmployment[]

  subscriptions Subscriptions[]
  transactions  Transaction[]
  orders        Order[]

  ratings_given    Rating[] @relation("UserGivenRatings")
  ratings_received Rating[] @relation("UserReceivedRatings")

  pushTokens              PushToken[]
  notifications           Notification[]
  notificationPreferences NotificationPreference?

  @@map("users")
}

// ---------------------------------------------------------------------------
// Organization structure
// ---------------------------------------------------------------------------

model Company {
  id String @id @default(uuid()) @db.Uuid

  company_name     String                                 @db.VarChar
  company_address  String?                                @db.VarChar
  company_location Unsupported("geography(Point, 4326)")?
  gst_number       String?                                @db.VarChar
  is_verified      Boolean                                @default(false)
  preferences      Json                                   @default("{}")

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  // Relations
  departments   Department[]
  roles         CompanyRole[]
  members       CompanyMember[]
  jobs          Job[]
  shifts        Shift[]
  ratings       Rating[]
  employments   EmployeeEmployment[]
  transactions  Transaction[]
  orders        Order[]
  subscriptions Subscriptions[]

  @@index([company_name])
  @@map("companies")
}

/// Per-company role catalog (like Department).
/// Members reference `role_id` — rename/edit `name` without rewriting members.
/// `code` is the stable machine key used by backend (OWNER, ADMIN, ...).
model CompanyRole {
  id String @id @default(uuid()) @db.Uuid

  company_id String @db.Uuid

  /// Stable key for code lookups (OWNER, ADMIN, HR, CUSTOM_X, ...)
  code String @db.VarChar

  /// Display name — can be updated anytime
  name String @db.VarChar

  description String? @db.Text

  /// System roles are seeded defaults; protect from accidental delete
  is_system Boolean @default(false)
  is_active Boolean @default(true)

  /// Future RBAC hooks
  permissions Json? @default("{}")

  sort_order Int @default(0)

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  company Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  members CompanyMember[]

  @@unique([company_id, code])
  @@unique([company_id, name])
  @@index([company_id])
  @@index([code])
  @@map("company_roles")
}

model Department {
  id String @id @default(uuid()) @db.Uuid

  company_id  String  @db.Uuid
  name        String  @db.VarChar
  description String? @db.Text

  parent_department_id String? @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  // Relations
  company           Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  parent_department Department?  @relation("DepartmentHierarchy", fields: [parent_department_id], references: [id])
  child_departments Department[] @relation("DepartmentHierarchy")

  teams   Team[]
  members CompanyMember[]
  jobs    Job[]
  shifts  Shift[]

  @@unique([company_id, name])
  @@index([company_id])
  @@index([parent_department_id])
  @@map("departments")
}

model Team {
  id String @id @default(uuid()) @db.Uuid

  department_id String @db.Uuid
  name          String @db.VarChar

  lead_company_member_id String? @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  // Relations
  department Department @relation(fields: [department_id], references: [id], onDelete: Cascade)

  lead_company_member CompanyMember?  @relation("TeamLead", fields: [lead_company_member_id], references: [id])
  members             CompanyMember[] @relation("TeamMembers")

  jobs   Job[]
  shifts Shift[]

  @@unique([department_id, name])
  @@index([department_id])
  @@index([lead_company_member_id])
  @@map("teams")
}

model CompanyMember {
  id String @id @default(uuid()) @db.Uuid

  user_id       String  @db.Uuid
  company_id    String  @db.Uuid
  department_id String? @db.Uuid
  team_id       String? @db.Uuid

  /// FK into per-company role catalog (not a free-form string / global enum)
  role_id String @db.Uuid

  platform_type PlatformType

  // Manager hierarchy (self-relation)
  manager_company_member_id String? @db.Uuid

  is_active Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  // Relations
  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company    Company     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [department_id], references: [id])
  team       Team?       @relation("TeamMembers", fields: [team_id], references: [id])
  /// Restrict: cannot delete a role while members still reference it
  role       CompanyRole @relation(fields: [role_id], references: [id], onDelete: Restrict)

  manager CompanyMember?  @relation("ManagerHierarchy", fields: [manager_company_member_id], references: [id])
  reports CompanyMember[] @relation("ManagerHierarchy")

  led_teams Team[] @relation("TeamLead")

  jobs_created    Job[]   @relation("JobCreatedBy")
  shifts_created  Shift[] @relation("ShiftCreatedBy")
  shifts_assigned Shift[] @relation("ShiftAssignedTo")

  ratings_given    Rating[] @relation("MemberGivenRatings")
  ratings_received Rating[] @relation("MemberReceivedRatings")

  // One company per user for now.
  // To allow multi-company later: remove @@unique([user_id]) only.
  @@unique([user_id])
  @@unique([company_id, user_id])
  @@index([company_id])
  @@index([department_id])
  @@index([team_id])
  @@index([role_id])
  @@index([manager_company_member_id])
  @@index([platform_type])
  @@map("company_members")
}

// ---------------------------------------------------------------------------
// Shifts
// ---------------------------------------------------------------------------

model Shift {
  id String @id @default(uuid()) @db.Uuid

  // Organization ownership
  company_id    String  @db.Uuid
  department_id String? @db.Uuid
  team_id       String? @db.Uuid

  created_by_company_member_id String? @db.Uuid
  assigned_company_member_id   String? @db.Uuid

  // Shift-swap marketplace identities (User-level)
  original_employee_id    String  @db.Uuid
  replacement_employee_id String? @db.Uuid

  created_by PlatformType

  request_accepted Boolean @default(false)

  shift_date  DateTime @db.Timestamptz()
  shift_start DateTime @db.Timestamptz()
  shift_end   DateTime @db.Timestamptz()

  payType        PayType
  shift_pay      Decimal     @db.Decimal(10, 2)
  skill_required String      @db.VarChar
  status         ShiftStatus

  organization_approved Boolean @default(false)
  no_show_reported      Boolean @default(false)

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  // Relations
  company    Company     @relation(fields: [company_id], references: [id])
  department Department? @relation(fields: [department_id], references: [id])
  team       Team?       @relation(fields: [team_id], references: [id])

  created_by_member CompanyMember? @relation("ShiftCreatedBy", fields: [created_by_company_member_id], references: [id])
  assigned_member   CompanyMember? @relation("ShiftAssignedTo", fields: [assigned_company_member_id], references: [id])

  original_employee    User  @relation("OriginalEmployeeShift", fields: [original_employee_id], references: [id])
  replacement_employee User? @relation("ReplacementEmployeeShift", fields: [replacement_employee_id], references: [id])

  ratings           Rating[]
  shiftApplications ShiftApplication[]

  @@index([company_id])
  @@index([department_id])
  @@index([team_id])
  @@index([created_by_company_member_id])
  @@index([assigned_company_member_id])
  @@index([original_employee_id])
  @@index([replacement_employee_id])
  @@index([status])
  @@map("shifts")
}

model ShiftApplication {
  id String @id @default(uuid()) @db.Uuid

  shift_id String @db.Uuid
  user_id  String @db.Uuid

  type   ShiftApplicationType
  status ShiftApplicationStatus @default(pending)

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  shift Shift @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id])

  @@unique([shift_id, user_id])
  @@index([shift_id])
  @@index([user_id])
  @@map("shift_applications")
}

// ---------------------------------------------------------------------------
// Jobs / ATS
// ---------------------------------------------------------------------------

model Job {
  id String @id @default(uuid()) @db.Uuid

  company_id                   String  @db.Uuid
  department_id                String? @db.Uuid
  team_id                      String? @db.Uuid
  created_by_company_member_id String? @db.Uuid

  title       String @db.VarChar(255)
  description String @db.Text

  employment_type EmploymentType
  work_type       JobWorkType

  salary_min    Decimal?   @db.Decimal(10, 2)
  salary_max    Decimal?   @db.Decimal(10, 2)
  salary_type   SalaryType
  is_negotiable Boolean    @default(false)

  job_start_time DateTime? @db.Timestamptz()
  job_end_time   DateTime? @db.Timestamptz()

  address  String?                               @db.Text
  location Unsupported("geography(Point,4326)")?

  seats_available Int?

  status     JobStatus @default(open)
  expires_at DateTime? @db.Timestamptz()

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  company           Company        @relation(fields: [company_id], references: [id])
  department        Department?    @relation(fields: [department_id], references: [id])
  team              Team?          @relation(fields: [team_id], references: [id])
  created_by_member CompanyMember? @relation("JobCreatedBy", fields: [created_by_company_member_id], references: [id])

  applications JobApplication[]
  ratings      Rating[]

  @@index([company_id])
  @@index([department_id])
  @@index([team_id])
  @@index([created_by_company_member_id])
  @@index([status])
  @@index([expires_at])
  @@index([job_start_time])
  @@map("jobs")
}

model JobApplication {
  id String @id @default(uuid()) @db.Uuid

  job_id  String @db.Uuid
  user_id String @db.Uuid

  status JobApplicationStatus @default(applied)

  cover_letter   String? @db.Text
  employer_notes String? @db.Text

  applied_at     DateTime  @default(now()) @db.Timestamptz()
  reviewed_at    DateTime? @db.Timestamptz()
  shortlisted_at DateTime? @db.Timestamptz()
  interview_at   DateTime? @db.Timestamptz()
  hired_at       DateTime? @db.Timestamptz()
  rejected_at    DateTime? @db.Timestamptz()
  withdrawn_at   DateTime? @db.Timestamptz()

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  job  Job  @relation(fields: [job_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id])

  @@unique([job_id, user_id])
  @@index([job_id])
  @@index([user_id])
  @@index([status])
  @@index([job_id, status])
  @@map("job_applications")
}

// ---------------------------------------------------------------------------
// Ratings
// ---------------------------------------------------------------------------

model Rating {
  id String @id @default(uuid()) @db.Uuid

  // Who gave / received the rating (User identity)
  from_user_id String @db.Uuid
  to_user_id   String @db.Uuid

  // Optional company-member context
  from_company_member_id String? @db.Uuid
  to_company_member_id   String? @db.Uuid

  company_id String? @db.Uuid
  shift_id   String? @db.Uuid
  job_id     String? @db.Uuid

  score         Int
  review        String? @db.Text
  flagged_issue Boolean @default(false)

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  from_user User @relation("UserGivenRatings", fields: [from_user_id], references: [id])
  to_user   User @relation("UserReceivedRatings", fields: [to_user_id], references: [id])

  from_company_member CompanyMember? @relation("MemberGivenRatings", fields: [from_company_member_id], references: [id])
  to_company_member   CompanyMember? @relation("MemberReceivedRatings", fields: [to_company_member_id], references: [id])

  company Company? @relation(fields: [company_id], references: [id])
  shift   Shift?   @relation(fields: [shift_id], references: [id])
  job     Job?     @relation(fields: [job_id], references: [id])

  @@unique([shift_id, from_user_id, to_user_id])
  @@unique([job_id, from_user_id, to_user_id])
  @@index([from_user_id])
  @@index([to_user_id])
  @@index([from_company_member_id])
  @@index([to_company_member_id])
  @@index([company_id])
  @@index([shift_id])
  @@index([job_id])
  @@map("ratings")
}

// ---------------------------------------------------------------------------
// Subscriptions / Billing
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id     String         @id @default(uuid()) @db.Uuid
  name   String         @db.VarChar
  target TargetAudience

  price         Decimal? @db.Decimal(10, 2)
  billing_cycle String?  @db.VarChar
  features      Json?    @db.JsonB

  is_active Boolean @default(true)

  created_at    DateTime        @default(now()) @db.Timestamptz()
  updated_at    DateTime        @updatedAt @db.Timestamptz()
  subscriptions Subscriptions[]

  @@map("subscription_plans")
}

model Subscriptions {
  id String @id @default(uuid()) @db.Uuid

  // Individual subscription (marketplace worker)
  user_id String? @db.Uuid

  // Company subscription (org / employer side)
  company_id String? @db.Uuid

  plan_id String @db.Uuid

  // Who owns this subscription at platform level
  subscription_platform_type PlatformType
  status                     SubscriptionStatus

  starts_at  DateTime? @db.Timestamptz()
  expires_at DateTime? @db.Timestamptz()

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  user         User?            @relation(fields: [user_id], references: [id])
  company      Company?         @relation(fields: [company_id], references: [id])
  plan         SubscriptionPlan @relation(fields: [plan_id], references: [id])
  transactions Transaction[]

  @@index([user_id])
  @@index([company_id])
  @@index([plan_id])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Employment history (HRMS)
// ---------------------------------------------------------------------------

model EmployeeEmployment {
  id String @id @default(uuid()) @db.Uuid

  company_id  String @db.Uuid
  employee_id String @db.Uuid

  employee_no       String?          @db.VarChar
  employment_status EmploymentStatus

  joined_at DateTime  @db.Timestamptz()
  left_at   DateTime? @db.Timestamptz()

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  company  Company @relation(fields: [company_id], references: [id])
  employee User    @relation(fields: [employee_id], references: [id])

  @@unique([company_id, employee_id])
  @@index([company_id])
  @@index([employee_id])
  @@map("employee_employments")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Transaction {
  id String @id @default(uuid()) @db.Uuid

  user_id         String? @db.Uuid
  company_id      String? @db.Uuid
  subscription_id String? @db.Uuid
  order_id        String? @db.Uuid

  type                      TransactionType
  transaction_platform_type PlatformType
  amount                    Decimal           @db.Decimal(10, 2)
  status                    TransactionStatus
  payment_mode              PaymentMode

  razorpay_payment_id String? @db.VarChar
  razorpay_order_id   String? @db.VarChar
  razorpay_signature  String? @db.VarChar

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  company      Company?       @relation(fields: [company_id], references: [id])
  user         User?          @relation(fields: [user_id], references: [id])
  subscription Subscriptions? @relation(fields: [subscription_id], references: [id])
  order        Order?         @relation(fields: [order_id], references: [id])

  @@index([user_id])
  @@index([company_id])
  @@index([subscription_id])
  @@index([order_id])
  @@map("transactions")
}

model Order {
  id String @id @default(uuid()) @db.Uuid

  company_id          String?      @db.Uuid
  user_id             String?      @db.Uuid
  order_platform_type PlatformType
  order_date          DateTime     @db.Timestamptz()
  total_price         Decimal?     @db.Decimal(10, 2)

  payment_status PaymentStatus

  shipping_address String? @db.VarChar
  address_id       String? @db.VarChar

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  company      Company?      @relation(fields: [company_id], references: [id])
  user         User?         @relation(fields: [user_id], references: [id])
  transactions Transaction[]

  @@index([company_id])
  @@index([user_id])
  @@map("orders")
}

// ---------------------------------------------------------------------------
// Platform admin (separate from company roles)
// ---------------------------------------------------------------------------

model Admin {
  id            String @id @default(uuid()) @db.Uuid
  name          String @db.VarChar
  email         String @unique @db.VarChar
  role          String @default("admin")
  password_hash String @db.VarChar

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  @@map("admins")
}

// ---------------------------------------------------------------------------
// Auth helpers / leads / notifications
// ---------------------------------------------------------------------------

model OtpVerification {
  id String @id @default(uuid()) @db.Uuid

  phone_no String? @db.VarChar
  email    String? @db.VarChar

  otp  String @db.VarChar
  role String @db.VarChar

  payload Json? @default("{}")

  expires_at DateTime @db.Timestamptz()
  created_at DateTime @default(now()) @db.Timestamptz()

  @@unique([phone_no, role])
  @@unique([email, role])
  @@map("otp_verifications")
}

model Lead {
  id String @id @default(uuid()) @db.Uuid

  fullName     String
  email        String @db.VarChar(255)
  mobileNumber String @db.VarChar(20)

  subject String @db.VarChar(255)
  message String @db.Text

  isResolved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@map("leads")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  user_id   String   @db.Uuid
  token     String   @unique
  platform  String?
  deviceId  String?  @map("device_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

model Notification {
  id      String @id @default(uuid()) @db.Uuid
  user_id String @db.Uuid
  type    String
  title   String
  body    String
  data    Json?

  isRead Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, isRead])
  @@index([user_id])
  @@map("notifications")
}

model NotificationPreference {
  user_id String @id @db.Uuid

  shiftSwap Boolean @default(true) @map("shift_swap")
  jobAlert  Boolean @default(true) @map("job_alert")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("notification_preferences")
}
