// =============================================================================
// KBDL Prisma schema (multi-file)
// =============================================================================
// Prisma loads EVERY *.prisma file under packages/db/prisma/ (see prisma.config.ts).
// Migrations stay in prisma/migrations/ next to this datasource file.
//
// MODULE INDEX (packages/db/prisma/models/)
// -----------------------------------------------------------------------------
// 00-enums.prisma               Shared enums (status / type fields)
// 01-identity-user.prisma       App User (auth + marketplace profile)
// 02-company-org.prisma         Company, roles, dept, team, members
// 03-company-settings.prisma    Payroll / statutory / work week / OT settings
// 04-attendance.prisma          WorkShift, EmployeeShift, Attendance, holidays
// 05-marketplace-shifts.prisma  Gig / shift-swap Shift (+ applications)
// 06-jobs.prisma                Jobs + ATS applications
// 07-ratings.prisma             Ratings
// 08-subscriptions.prisma       Plans + subscriptions
// 09-hrms.prisma                WorkforcePerson, employment, HR profile/docs
// 10-payments.prisma            Transactions + orders
// 11-platform.prisma            Admin, OTP, leads, notifications
//
// FIELD CONVENTIONS
// -----------------------------------------------------------------------------
// - IDs: String @id @default(uuid()) @db.Uuid
// - Timestamps: created_at / updated_at with @db.Timestamptz()
// - Table names: @@map("snake_plural")
// - Relations: FK fields end with _id; named relations when ambiguous
// - PostGIS: Unsupported("geography(Point, 4326)") on location fields
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}
