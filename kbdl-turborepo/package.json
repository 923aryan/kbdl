{
  "name": "kbdl-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=kbdl-backend --filter=kbdl-employer --filter=kbdl-admin --filter=kbdl-landing",
    "dev:all": "turbo run dev",
    "dev:backend": "turbo run dev --filter=kbdl-backend",
    "dev:frontend": "turbo run dev --filter=kbdl-employer --filter=kbdl-admin --filter=kbdl-landing",
    "dev:employer": "turbo run dev --filter=kbdl-employer",
    "dev:admin": "turbo run dev --filter=kbdl-admin",
    "dev:landing": "turbo run dev --filter=kbdl-landing",
    "dev:web": "turbo run dev --filter=kbdl-backend --filter=kbdl-employer",
    "db:seed": "pnpm --filter @repo/db seed",
    "db:push": "pnpm --filter @repo/db push",
    "docker:up": "docker compose up --build",
    "docker:up:detach": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:seed": "docker compose run --rm backend seed",
    "docker:reset-seed": "docker compose run --rm backend reset-seed",
    "docker:logs": "docker compose logs -f backend",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
