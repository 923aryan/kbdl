# # Copy this file to `.env` in the same folder (kbdl-turborepo):
# #   copy .env.example .env
# #
# # Docker Compose reads `.env` automatically for ${VAR} substitution.
# # Do NOT commit `.env` (secrets).

# # --- Postgres ---
# POSTGRES_USER=kbdl
# POSTGRES_PASSWORD=kbdl
# POSTGRES_DB=kbdl
# POSTGRES_PORT=5432

# # --- Redis ---
# REDIS_PASSWORD=kbdlredis
# REDIS_PORT=6379

# # --- Backend ---
# NODE_ENV=development
# PORT=8000
# JWT_ACCESS_SECRET=docker-dev-access-secret-change-me
# JWT_REFRESH_SECRET=docker-dev-refresh-secret-change-me
# JWT_ACCESS_EXPIRY=7d
# JWT_REFRESH_EXPIRY=14d
# RESEND_API_KEY=re_docker_placeholder
# EMPLOYER_URL=http://localhost:3002
# GEOAPIFY_API_KEY=docker-geoapify-placeholder

# # Destructive: clears DB then seeds when backend starts
# SEED_ON_START=false
